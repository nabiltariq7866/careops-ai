+                toast.success(`Switched to ${e.target.value}`);
+              }}
+            >
+              {[
+                "Operations Manager",
+                "Clinician",
+                "Nurse",
+                "Care Coordinator",
+                "Safety Officer",
+                "Administrator",
+                "Patient",
+              ].map((x) => (
+                <option key={x}>{x}</option>
+              ))}
+            </select>
+          </label>
+          <p className="muted">
+            Current role is persisted. Patient role emphasizes the portal;
+            Safety Officer enables safety-review actions.
+          </p>
+        </Card>
+      </div>
+    </Page>
+  );
+}
