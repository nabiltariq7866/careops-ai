+            </Card>
+            <Card>
+              <h2>Corrective actions</h2>
+              {actions.length ? (
+                <table>
+                  <tbody>
+                    {actions.map((a) => (
+                      <tr key={a.id}>
+                        <td>
+                          <b>{a.action}</b>
+                          <small>{a.rootCause}</small>
+                        </td>
+                        <td>
+                          <input
+                            aria-label={`Owner for ${a.action}`}
