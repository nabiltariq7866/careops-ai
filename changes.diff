+  align-items: center;
+  padding: 8px;
+}
+.popover header button {
+  border: 0;
+  background: none;
+  color: #2f6f9f;
+  font-size: 11px;
+}
+.popover > button {
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  text-align: left;
+  border: 0;
+  background: white;
+  border-top: 1px solid #edf1f3;
+  padding: 10px;
+  border-radius: 5px;
+}
+.popover > button:hover {
+  background: #f5f8fa;
+}
+.popover span,
+.popover small {
+  color: #667784;
+  margin-top: 3px;
+}
+.profilepop {
+  top: 60px;
+  right: 22px;
+  width: 220px;
+  display: flex;
+  flex-direction: column;
+  gap: 7px;
+  padding: 14px;
+}
+.profilepop a {
+  border-top: 1px solid #e2e8ec;
+  padding-top: 9px;
+  color: #2f6f9f;
+}
+.profileactions {
+  margin-left: auto;
+}
+.ambientempty {
+  text-align: center;
+  padding: 45px;
+  color: #667784;
+}
+.ambientempty > svg {
+  width: 40px;
+  height: 40px;
+  color: #6750a4;
+}
+.transcript {
+  background: #f6f8f9;
+  border-left: 3px solid #2f6f9f;
+  padding: 15px;
+  margin-bottom: 15px;
+}
+.clinicaldraft textarea {
+  display: block;
+  width: 100%;
+  resize: vertical;
+  min-height: 55px;
+}
+.insightrow {
+  display: flex;
+  gap: 10px;
+  padding: 14px 0;
+  border-bottom: 1px solid #e4eaee;
+}
+.insightrow > svg {
+  color: #6750a4;
+  width: 18px;
+}
+.insightrow p {
+  margin: 5px 0;
+}
+.insightrow small {
+  color: #789;
+}
+.message {
+  margin: 8px 0;
+}
+.message.patientmsg {
+  margin-left: 20%;
+  background: #e7f1f7;
+}
+.resources button {
+  border: 1px solid #d4e0e6;
+  background: #edf4f7;
+  padding: 6px 9px;
+  border-radius: 5px;
+}
+.resources button.active {
+  background: #2f6f9f;
+  color: white;
+}
+.integrationgrid .btn {
+  margin-top: 12px;
+  width: 100%;
+}
+@media (max-width: 1200px) {
+  .kpis {
+    grid-template-columns: repeat(3, 1fr);
+  }
+  .integrationgrid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+  .flowboard {
+    grid-template-columns: 1fr;
+  }
+}
+@media (max-width: 850px) {
+  .app {
+    display: block;
+  }
+  aside {
+    position: static;
+    width: 100%;
+    height: auto;
+  }
+  .navgroup {
+    display: none;
+  }
+  main {
+    grid-column: auto;
+  }
+  .top {
+    padding: 0 12px;
+    gap: 8px;
+  }
+  .globalsearch,
+  .profile,
+  .profilebutton {
+    display: none;
+  }
+  .facility select {
+    max-width: 180px;
+  }
+  .pagehead,
+  .portalrow,
+  .rowactions {
+    flex-wrap: wrap;
+  }
+  .portalrow {
+    gap: 8px;
+  }
+  .content,
+  .card {
+    max-width: 100%;
+    overflow-x: auto;
+  }
+  .portalhero {
+    gap: 12px;
+    flex-wrap: wrap;
+  }
+  .content {
+    padding: 18px;
+  }
+  .grid.two,
+  .grid.thirds,
+  .copilot {
+    grid-template-columns: 1fr;
+  }
+  .kpis,
+  .summaryrow {
+    grid-template-columns: repeat(2, 1fr);
+  }
+  .formgrid {
+    grid-template-columns: 1fr;
+  }
+  .flowviz {
+    flex-direction: column;
+  }
+  .flowviz i {
+    transform: rotate(90deg);
+  }
+  .bedgrid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+}
