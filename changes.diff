+import { recommendAppointments, type Slot } from "../services/ai/waitingListAI";
+const fallbackSlots: Slot[] = [
+  {
+    practitioner: "Dr Sarah Wilson",
+    date: "2026-08-13",
+    time: "10:30",
+    location: "Clinic 2",
+    score: 96,
+    reason: ["Earliest suitable slot"],
+  },
+  {
